# Firmware configuration file for the Pastigio FRAME156 (RK3326)
#
# IMPORTANT:
# Edit `fwup.conf.eex` and run `mix generate_fwup_conf` to generate fwup.conf.
#
# The Rockchip boot chain (idbloader, U-Boot, trust) and the U-Boot logo
# partition from the stock firmware are never written. U-Boot boots the
# boot image partition named "boot" (the validated slot), and an upgrade
# tries the other slot once with "reboot recovery". See
# fwup_include/fwup-common.conf.
#
# U-Boot environment variables (only nerves_runtime and fwup read them):
#   nerves_fw_boot_slot  slot whose boot image partition is named "boot"
#   nerves_fw_active     slot being run, or about to be tried
#   nerves_fw_validated  "0" until the tried slot validates
#
require-fwup-version="1.12.0"

include("${NERVES_SDK_IMAGES:-.}/fwup_include/fwup-common.conf")
include("${NERVES_SDK_IMAGES:-.}/fwup_include/fwup-gpt.conf")

<%
slots = [
  %{name: "a", other: "b"},
  %{name: "b", other: "a"}
]
%>
# File resources are listed in the order that they are included in the .fw
# file. This is important, since this is the order that they're written on a
# firmware update due to the event driven nature of the update system.
file-resource uboot-env.bin {
    host-path = "${NERVES_SYSTEM}/images/uboot-env.bin"
    assert-size-lte = ${UBOOT_ENV_COUNT}
}
<%= for slot <- slots do %>file-resource boot-<%= slot.name %>.img {
    host-path = "${NERVES_SYSTEM}/images/boot-<%= slot.name %>.img"
    assert-size-lte = ${BOOT_<%= String.upcase(slot.name) %>_PART_COUNT}
}
<% end %>file-resource rootfs.img {
    host-path = ${ROOTFS}

    # Error out if the rootfs size exceeds the partition size
    assert-size-lte = ${ROOTFS_A_PART_COUNT}
}


# Location where installed firmware information is stored.
uboot-environment uboot-env {
    block-offset = ${UBOOT_ENV_OFFSET}
    block-count = ${UBOOT_ENV_COUNT}
}

# This firmware task writes everything to the destination media.
# The stock Rockchip boot chain must already be on the eMMC.
task complete {
    # Only match if not mounted
    require-unmounted-destination = true

    on-init {
        # Slot A is the validated one
        gpt_write(gpt-boot-a)
        # No Android bootloader message, which would stick
        raw_memset(${MISC_PART_OFFSET}, 4, 0x00)
    }

    on-resource uboot-env.bin {
        # Boot to the A partition first
        raw_write(${UBOOT_ENV_OFFSET})

        include("${NERVES_PROVISIONING}")

        uboot_setenv(uboot-env, "nerves_fw_devpath", ${NERVES_FW_DEVPATH})
        uboot_setenv(uboot-env, "nerves_fw_boot_slot", "a")
        uboot_setenv(uboot-env, "nerves_fw_active", "a")
        uboot_setenv(uboot-env, "nerves_fw_validated", "1")
        uboot_setenv(uboot-env, "a.nerves_fw_application_part0_devpath", ${NERVES_FW_APPLICATION_PART0_DEVPATH})
        uboot_setenv(uboot-env, "a.nerves_fw_application_part0_fstype", ${NERVES_FW_APPLICATION_PART0_FSTYPE})
        uboot_setenv(uboot-env, "a.nerves_fw_application_part0_target", ${NERVES_FW_APPLICATION_PART0_TARGET})
        uboot_setenv(uboot-env, "a.nerves_fw_product", ${NERVES_FW_PRODUCT})
        uboot_setenv(uboot-env, "a.nerves_fw_description", ${NERVES_FW_DESCRIPTION})
        uboot_setenv(uboot-env, "a.nerves_fw_version", ${NERVES_FW_VERSION})
        uboot_setenv(uboot-env, "a.nerves_fw_platform", ${NERVES_FW_PLATFORM})
        uboot_setenv(uboot-env, "a.nerves_fw_architecture", ${NERVES_FW_ARCHITECTURE})
        uboot_setenv(uboot-env, "a.nerves_fw_author", ${NERVES_FW_AUTHOR})
        uboot_setenv(uboot-env, "a.nerves_fw_vcs_identifier", ${NERVES_FW_VCS_IDENTIFIER})
        uboot_setenv(uboot-env, "a.nerves_fw_misc", ${NERVES_FW_MISC})
        uboot_setenv(uboot-env, "a.nerves_fw_uuid", "\${FWUP_META_UUID}")
    }

    on-resource boot-a.img { raw_write(${BOOT_A_PART_OFFSET}) }

    on-resource rootfs.img {
        # write to the first rootfs partition
        raw_write(${ROOTFS_A_PART_OFFSET})
    }

    on-finish {
        # Nothing bootable in slot B yet
        raw_memset(${BOOT_B_PART_OFFSET}, 256, 0x00)

        # Clear out any old data in the B partition that might be mistaken for
        # a file system. This is mostly to avoid confusion in humans.
        raw_memset(${ROOTFS_B_PART_OFFSET}, 256, 0xff)

        # Invalidate the application data partition so that it is guaranteed
        # to trigger the corrupt filesystem detection code on first boot and
        # get formatted. Android's userdata used to be here.
        raw_memset(${APP_PART_OFFSET}, 256, 0xff)
    }
}
<%= for slot <- slots do %>
task upgrade.<%= slot.name %> {
    # This task upgrades the <%= String.upcase(slot.name) %> partition, so make sure we're running
    # on <%= String.upcase(slot.other) %>, and that <%= String.upcase(slot.other) %> is the validated slot. Upgrading
    # from a slot that's on trial would overwrite the firmware to go back to.
    require-path-at-offset("/", ${ROOTFS_<%= String.upcase(slot.other) %>_PART_OFFSET})
    require-uboot-variable(uboot-env, "nerves_fw_boot_slot", "<%= slot.other %>")

    # Verify the expected platform/architecture
    require-uboot-variable(uboot-env, "<%= slot.other %>.nerves_fw_platform", "${NERVES_FW_PLATFORM}")
    require-uboot-variable(uboot-env, "<%= slot.other %>.nerves_fw_architecture", "${NERVES_FW_ARCHITECTURE}")

    on-init {
        info("Upgrading partition <%= String.upcase(slot.name) %>")

        # Clear some firmware information just in case this update gets
        # interrupted midway. If this partition was bootable, it's not going to
        # be soon.
        uboot_unsetenv(uboot-env, "<%= slot.name %>.nerves_fw_version")
        uboot_unsetenv(uboot-env, "<%= slot.name %>.nerves_fw_platform")
        uboot_unsetenv(uboot-env, "<%= slot.name %>.nerves_fw_architecture")
        uboot_unsetenv(uboot-env, "<%= slot.name %>.nerves_fw_uuid")

        # Indicate that the entire partition can be cleared
        trim(${ROOTFS_<%= String.upcase(slot.name) %>_PART_OFFSET}, ${ROOTFS_<%= String.upcase(slot.name) %>_PART_COUNT})
    }

    # Write the new boot image and rootfs. U-Boot only boots this slot
    # after the "reboot recovery" requested at the end, so an error or power
    # failure during this part won't hurt anything.
    on-resource boot-<%= slot.name %>.img { raw_write(${BOOT_<%= String.upcase(slot.name) %>_PART_OFFSET}) }
    on-resource rootfs.img {
        delta-source-raw-offset=${ROOTFS_<%= String.upcase(slot.other) %>_PART_OFFSET}
        delta-source-raw-count=${ROOTFS_<%= String.upcase(slot.other) %>_PART_COUNT}
        raw_write(${ROOTFS_<%= String.upcase(slot.name) %>_PART_OFFSET})
    }


    on-finish {
        # Update firmware metadata
        uboot_setenv(uboot-env, "<%= slot.name %>.nerves_fw_application_part0_devpath", ${NERVES_FW_APPLICATION_PART0_DEVPATH})
        uboot_setenv(uboot-env, "<%= slot.name %>.nerves_fw_application_part0_fstype", ${NERVES_FW_APPLICATION_PART0_FSTYPE})
        uboot_setenv(uboot-env, "<%= slot.name %>.nerves_fw_application_part0_target", ${NERVES_FW_APPLICATION_PART0_TARGET})
        uboot_setenv(uboot-env, "<%= slot.name %>.nerves_fw_product", ${NERVES_FW_PRODUCT})
        uboot_setenv(uboot-env, "<%= slot.name %>.nerves_fw_description", ${NERVES_FW_DESCRIPTION})
        uboot_setenv(uboot-env, "<%= slot.name %>.nerves_fw_version", ${NERVES_FW_VERSION})
        uboot_setenv(uboot-env, "<%= slot.name %>.nerves_fw_platform", ${NERVES_FW_PLATFORM})
        uboot_setenv(uboot-env, "<%= slot.name %>.nerves_fw_architecture", ${NERVES_FW_ARCHITECTURE})
        uboot_setenv(uboot-env, "<%= slot.name %>.nerves_fw_author", ${NERVES_FW_AUTHOR})
        uboot_setenv(uboot-env, "<%= slot.name %>.nerves_fw_vcs_identifier", ${NERVES_FW_VCS_IDENTIFIER})
        uboot_setenv(uboot-env, "<%= slot.name %>.nerves_fw_misc", ${NERVES_FW_MISC})
        uboot_setenv(uboot-env, "<%= slot.name %>.nerves_fw_uuid", "\${FWUP_META_UUID}")

        uboot_setenv(uboot-env, "nerves_fw_active", "<%= slot.name %>")
        uboot_setenv(uboot-env, "nerves_fw_validated", "0")

        # Try the new slot once. If it fails before validating, U-Boot boots
        # the old slot again on the next reset or power cycle.
        reboot_param("recovery")
    }

    on-error {
    }
}
<% end %>
task upgrade.unvalidated.a {
    require-path-at-offset("/", ${ROOTFS_A_PART_OFFSET})
    require-uboot-variable(uboot-env, "a.nerves_fw_platform", "${NERVES_FW_PLATFORM}")
    require-uboot-variable(uboot-env, "a.nerves_fw_architecture", "${NERVES_FW_ARCHITECTURE}")
    on-init {
        error("Slot A is on trial. Validate it, or reboot into the validated slot, before upgrading.")
    }
}

task upgrade.unvalidated.b {
    require-path-at-offset("/", ${ROOTFS_B_PART_OFFSET})
    require-uboot-variable(uboot-env, "b.nerves_fw_platform", "${NERVES_FW_PLATFORM}")
    require-uboot-variable(uboot-env, "b.nerves_fw_architecture", "${NERVES_FW_ARCHITECTURE}")
    on-init {
        error("Slot B is on trial. Validate it, or reboot into the validated slot, before upgrading.")
    }
}

task upgrade.unexpected {
    require-uboot-variable(uboot-env, "a.nerves_fw_platform", "${NERVES_FW_PLATFORM}")
    require-uboot-variable(uboot-env, "a.nerves_fw_architecture", "${NERVES_FW_ARCHITECTURE}")
    on-init {
        error("Please check the media being upgraded. It doesn't look like either the A or B partitions are active.")
    }
}

task upgrade.wrongplatform {
    on-init {
        error("Expecting platform=${NERVES_FW_PLATFORM} and architecture=${NERVES_FW_ARCHITECTURE}")
    }
}

task provision {
    require-uboot-variable(uboot-env, "a.nerves_fw_platform", "${NERVES_FW_PLATFORM}")
    require-uboot-variable(uboot-env, "a.nerves_fw_architecture", "${NERVES_FW_ARCHITECTURE}")
    on-init {
        include("${NERVES_PROVISIONING}")
    }
}
task provision.wrongplatform {
    on-init {
        error("Expecting platform=${NERVES_FW_PLATFORM} and architecture=${NERVES_FW_ARCHITECTURE}")
    }
}
