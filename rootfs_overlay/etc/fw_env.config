# fw_printenv and fw_setenv configuration
#
# This is only used for storing firmware metadata. The vendor U-Boot never
# reads it directly; boot.scr imports it with raw MMC reads.
#
# See fwup_include/fwup-common.conf for offset and size

# Device name	Device offset	Env. size
/dev/mmcblk0	0x2400000	0x20000
