From: Ben Bangert <100193+bbangert@users.noreply.github.com>
Subject: [PATCH] drm/rockchip: vop: add plane alpha for PX30

The PX30 VOP windows have a global alpha value in bits 11:4 of their
ALPHA_CTRL register, which Rockchip's vendor driver uses. Expose it as
the standard "alpha" property on the overlay and cursor planes, so the
display controller can blend two full-screen images (a photo crossfade)
without the GPU. The windows have a single alpha mode bit, so a plane
with alpha below opaque uses global alpha only.

The windows are stacked in index order, which an immutable "zpos"
property now reports.
---
 drivers/gpu/drm/rockchip/rockchip_drm_vop.c | 32 ++++++++++++++++++---
 drivers/gpu/drm/rockchip/rockchip_drm_vop.h |  1 +
 drivers/gpu/drm/rockchip/rockchip_vop_reg.c |  3 ++
 3 files changed, 32 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_vop.c b/drivers/gpu/drm/rockchip/rockchip_drm_vop.c
index 572f4ad..f44d8f8 100644
--- a/drivers/gpu/drm/rockchip/rockchip_drm_vop.c
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_vop.c
@@ -929,6 +929,7 @@ static void vop_plane_atomic_update(struct drm_plane *plane,
 	uint32_t val;
 	bool rb_swap, uv_swap;
 	int win_index = VOP_WIN_TO_INDEX(vop_win);
+	u32 plane_alpha = new_state->alpha >> 8;
 	int format;
 	int is_yuv = fb->format->is_yuv;
 	int i;
@@ -1047,7 +1048,21 @@ static void vop_plane_atomic_update(struct drm_plane *plane,
 	 * with the default opaque black default background color is a no-op,
 	 * so we can just disable blending to get the correct result.
 	 */
-	if (fb->format->has_alpha && win_index > 0) {
+	if (VOP_WIN_HAS_REG(win, global_alpha_val))
+		VOP_WIN_SET(vop, win, global_alpha_val, plane_alpha);
+
+	if (win_index > 0 && plane_alpha != 0xff &&
+	    VOP_WIN_HAS_REG(win, global_alpha_val)) {
+		/*
+		 * Plane alpha. These windows have one alpha mode bit, so it
+		 * replaces per-pixel alpha rather than combining with it.
+		 * alpha_pre_mul = 0 means the colour isn't premultiplied, so
+		 * the VOP scales it by the alpha.
+		 */
+		VOP_WIN_SET(vop, win, alpha_pre_mul, 0);
+		VOP_WIN_SET(vop, win, alpha_mode, ALPHA_GLOBAL);
+		VOP_WIN_SET(vop, win, alpha_en, 1);
+	} else if (fb->format->has_alpha && win_index > 0) {
 		VOP_WIN_SET(vop, win, dst_alpha_ctl,
 			    DST_FACTOR_M0(ALPHA_SRC_INVERSE));
 		val = SRC_ALPHA_EN(1) | SRC_COLOR_M0(ALPHA_SRC_PRE_MUL) |
@@ -1841,10 +1856,19 @@ out:
 }
 
 static void vop_plane_add_properties(struct drm_plane *plane,
-				     const struct vop_win_data *win_data)
+				     const struct vop_win_data *win_data,
+				     unsigned int zpos)
 {
 	unsigned int flags = 0;
 
+	if (VOP_WIN_HAS_REG(win_data, global_alpha_val)) {
+		/* The windows are stacked in index order */
+		drm_plane_create_zpos_immutable_property(plane, zpos);
+		/* No alpha on win0, see vop_plane_atomic_update() */
+		if (win_data->type != DRM_PLANE_TYPE_PRIMARY)
+			drm_plane_create_alpha_property(plane);
+	}
+
 	flags |= VOP_WIN_HAS_REG(win_data, x_mir_en) ? DRM_MODE_REFLECT_X : 0;
 	flags |= VOP_WIN_HAS_REG(win_data, y_mir_en) ? DRM_MODE_REFLECT_Y : 0;
 	if (flags)
@@ -1890,7 +1914,7 @@ static int vop_create_crtc(struct vop *vop)
 
 		plane = &vop_win->base;
 		drm_plane_helper_add(plane, &plane_helper_funcs);
-		vop_plane_add_properties(plane, win_data);
+		vop_plane_add_properties(plane, win_data, i);
 		if (plane->type == DRM_PLANE_TYPE_PRIMARY)
 			primary = plane;
 		else if (plane->type == DRM_PLANE_TYPE_CURSOR)
@@ -1933,7 +1957,7 @@ static int vop_create_crtc(struct vop *vop)
 			goto err_cleanup_crtc;
 		}
 		drm_plane_helper_add(&vop_win->base, &plane_helper_funcs);
-		vop_plane_add_properties(&vop_win->base, win_data);
+		vop_plane_add_properties(&vop_win->base, win_data, i);
 	}
 
 	port = of_get_child_by_name(dev->of_node, "port");
diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_vop.h b/drivers/gpu/drm/rockchip/rockchip_drm_vop.h
index f04c973..10f570c 100644
--- a/drivers/gpu/drm/rockchip/rockchip_drm_vop.h
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_vop.h
@@ -205,6 +205,7 @@ struct vop_win_phy {
 	struct vop_reg alpha_pre_mul;
 	struct vop_reg alpha_mode;
 	struct vop_reg alpha_en;
+	struct vop_reg global_alpha_val;
 	struct vop_reg channel;
 };
 
diff --git a/drivers/gpu/drm/rockchip/rockchip_vop_reg.c b/drivers/gpu/drm/rockchip/rockchip_vop_reg.c
index b2f8ebf..f3f1ac5 100644
--- a/drivers/gpu/drm/rockchip/rockchip_vop_reg.c
+++ b/drivers/gpu/drm/rockchip/rockchip_vop_reg.c
@@ -319,6 +319,7 @@ static const struct vop_win_phy px30_win0_data = {
 	.alpha_pre_mul = VOP_REG(PX30_WIN0_ALPHA_CTRL, 0x1, 2),
 	.alpha_mode = VOP_REG(PX30_WIN0_ALPHA_CTRL, 0x1, 1),
 	.alpha_en = VOP_REG(PX30_WIN0_ALPHA_CTRL, 0x1, 0),
+	.global_alpha_val = VOP_REG(PX30_WIN0_ALPHA_CTRL, 0xff, 4),
 };
 
 static const struct vop_win_phy px30_win1_data = {
@@ -336,6 +337,7 @@ static const struct vop_win_phy px30_win1_data = {
 	.alpha_pre_mul = VOP_REG(PX30_WIN1_ALPHA_CTRL, 0x1, 2),
 	.alpha_mode = VOP_REG(PX30_WIN1_ALPHA_CTRL, 0x1, 1),
 	.alpha_en = VOP_REG(PX30_WIN1_ALPHA_CTRL, 0x1, 0),
+	.global_alpha_val = VOP_REG(PX30_WIN1_ALPHA_CTRL, 0xff, 4),
 };
 
 static const struct vop_win_phy px30_win2_data = {
@@ -353,6 +355,7 @@ static const struct vop_win_phy px30_win2_data = {
 	.alpha_pre_mul = VOP_REG(PX30_WIN2_ALPHA_CTRL, 0x1, 2),
 	.alpha_mode = VOP_REG(PX30_WIN2_ALPHA_CTRL, 0x1, 1),
 	.alpha_en = VOP_REG(PX30_WIN2_ALPHA_CTRL, 0x1, 0),
+	.global_alpha_val = VOP_REG(PX30_WIN2_ALPHA_CTRL, 0xff, 4),
 };
 
 static const struct vop_win_data px30_vop_big_win_data[] = {
