# Initial Nerves firmware metadata for the Pastigio FRAME156
#
# Buildroot turns this into uboot-env.bin (128 KiB, see nerves_defconfig),
# and fwup writes it to the raw environment block at sector 73728 when
# programming a complete image. boot.cmd holds the boot logic; this file
# only seeds the variables it uses.

nerves_fw_active=a

# nerves_fw_autovalidate controls whether updates are considered valid once
# applied. If set to 0, the user needs to set nerves_fw_validated to 1 in
# their application. If they don't set it before a reboot, then the
# previous software is run. If 1, then no further action needs to be taken.
nerves_fw_autovalidate=1

# nerves_fw_validated is 1 if the current boot selection is accepted. It is
# set to 1 here, since this environment is written in the factory, so it is
# implicitly valid.
nerves_fw_validated=1

# nerves_fw_booted is 0 for the first boot and 1 for all reboots after that.
nerves_fw_booted=0

# Boots since userspace last came up. boot.cmd enters loader mode when it
# would reach 4.
nerves_boot_tries=0
